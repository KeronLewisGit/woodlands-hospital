APP_NAME="Woodlands Hospital"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.woodlandshospital.com
APP_TIMEZONE=America/Guyana
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# One-time web installer (only needed if you have no SSH). Remove after setup.
SETUP_TOKEN=

LOG_CHANNEL=daily
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u000000000_woodlands
DB_USERNAME=u000000000_woodlands
DB_PASSWORD=

SESSION_DRIVER=database
# Results portal: sessions end after 30 idle minutes and when the browser closes.
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Hostinger mailbox (hPanel → Emails). Patient emails (confirmations, "results ready") go out from here.
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=wecare@woodlandshospital.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=wecare@woodlandshospital.com
MAIL_FROM_NAME="${APP_NAME}"

# true on the temporary preview domain: banner + noindex. Remove at launch.
WOODLANDS_PREVIEW=false
# Fallback recipients for new-request emails. The dashboard (Settings → Notification email) wins when filled in.
WOODLANDS_NOTIFY_EMAIL=

# First administrator, created by `php artisan db:seed` (or setup.php). Remove the password after first sign-in.
#ADMIN_NAME="Administrator"
#ADMIN_EMAIL=
#ADMIN_PASSWORD=
